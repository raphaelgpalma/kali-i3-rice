#!/usr/bin/env bash
# =============================================================================
# sys-info — System metrics for EWW
# =============================================================================

case "$1" in
  cpu)
    # CPU usage percentage (integer)
    top -bn1 | awk '/^%Cpu/ {printf "%d", 100 - $8}'
    ;;

  ram)
    # RAM usage percentage
    free | awk '/^Mem:/ {printf "%d", $3/$2 * 100}'
    ;;

  disk)
    # Root partition usage
    df -h / | awk 'NR==2 {gsub(/%/,""); print $5}'
    ;;

  temp)
    # CPU temperature
    if [ -f /sys/class/thermal/thermal_zone0/temp ]; then
      awk '{printf "%d", $1/1000}' /sys/class/thermal/thermal_zone0/temp
    elif command -v sensors &>/dev/null; then
      sensors 2>/dev/null | awk '/^(Package|Tctl|CPU)/ {gsub(/[^0-9.]/, "", $NF); printf "%d", $NF; exit}'
    else
      echo "N/A"
    fi
    ;;

  net-status)
    # Network connection status
    if ip route get 1.1.1.1 &>/dev/null 2>&1; then
      echo "connected"
    else
      echo "disconnected"
    fi
    ;;

  net-ip)
    # Local IP address
    ip -4 addr show scope global 2>/dev/null | awk '/inet / {gsub(/\/.*/, "", $2); print $2; exit}'
    ;;

  volume)
    # Volume level (0-100)
    pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk '{gsub(/%/, "", $5); print $5; exit}'
    ;;

  muted)
    # Mute status (true/false)
    pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}'
    ;;

  *)
    echo "Usage: sys-info {cpu|ram|disk|temp|net-status|net-ip|volume|muted}"
    ;;
esac
